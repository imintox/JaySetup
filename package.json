{
  "name": "jay-setup",
  "version": "1.3.0",
  "description": "Installs your essential apps after a fresh Windows install",
  "main": "main.js",
  "author": "Jayden M.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jay.setup",
    "productName": "Jay Setup",
    "artifactName": "JaySetup.exe",
    "files": ["main.js", "preload.js", "apps.js", "tweaks.js", "debloat.js", "index.html", "build/icon.ico"],
    "directories": { "output": "dist" },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
